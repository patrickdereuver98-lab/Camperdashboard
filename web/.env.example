# Kopieer naar .env.local. Alles is optioneel: zonder waarden gebruikt de site het live VrijStaan-project.
NEXT_PUBLIC_SUPABASE_URL=https://qkrmthrhwmmmwswmfgwc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=https://vrijstaan.nl

# Directe Postgres-verbinding (alleen voor scripts, migraties of toekomstige server-code; de website zelf gebruikt
# de REST-API en heeft dit niet nodig). Gebruik ALTIJD de Supavisor-pooler in transaction mode (poort 6543), nooit
# de directe host db.<ref>.supabase.co:5432: serverless functies openen per aanroep een verbinding en het gratis
# project heeft er maar 60. Te vinden in Supabase → Project Settings → Database → Connection pooling.
# SUPABASE_DB_URL=postgres://postgres.<ref>:<wachtwoord>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
