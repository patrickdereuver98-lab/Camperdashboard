# Overzicht van alle instellingen en geheimen van VrijStaan.
# Kopieer naar .env.local voor lokaal werk. Alles is optioneel: zonder waarden gebruikt de site het live project.
# Zet hier NOOIT echte geheimen in: dit bestand staat in git. .env.local en andere .env-bestanden worden genegeerd.
# Wat te doen bij een gelekte sleutel: docs/beveiliging/verbeterplan.md (B15).

# ── Website (Next.js, Vercel) ───────────────────────────────────────────────────────────────────────────────────────
# Openbaar: deze twee staan in de browser. Row Level Security beschermt de data, niet deze sleutel.
NEXT_PUBLIC_SUPABASE_URL=https://qkrmthrhwmmmwswmfgwc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=https://vrijstaan.nl

# Geheim (Vercel → Settings → Environment Variables). Zonder sleutel valt de routeplanner terug op OSRM.
# ORS_API_KEY=

# Bouwen zonder netwerk (CI): gebruik de meegeleverde snapshot.
# VRIJSTAAN_OFFLINE=1

# Directe Postgres-verbinding (alleen voor scripts, migraties of toekomstige server-code; de website zelf gebruikt
# de REST-API en heeft dit niet nodig). Gebruik ALTIJD de Supavisor-pooler in transaction mode (poort 6543), nooit
# de directe host db.<ref>.supabase.co:5432: serverless functies openen per aanroep een verbinding en het gratis
# project heeft er maar 60. Te vinden in Supabase → Project Settings → Database → Connection pooling.
# Geheim: bevat het databasewachtwoord. Ook als GitHub-secret voor backup.yml.
# SUPABASE_DB_URL=postgres://postgres.<ref>:<wachtwoord>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Edge functions (Supabase → Edge Functions → Secrets) ────────────────────────────────────────────────────────────
# SUPABASE_URL en SUPABASE_SERVICE_ROLE_KEY zet Supabase zelf. De service-role-sleutel omzeilt RLS: nooit in de
# website, nooit in GitHub, nooit in dit bestand.
# BRONNEN_MCP_KEY=          # geheim, toegang tot de MCP-server bronnen-mcp (alleen als Bearer-header gebruiken)
# De pipelinesleutel staat niet als secret maar in de tabel public.internal_secrets (name = 'pipeline_key').

# ── GitHub Actions (repository → Settings → Secrets and variables → Actions) ───────────────────────────────────────
# SUPABASE_DB_URL=          # geheim, back-up (backup.yml)
# BACKUP_PASSPHRASE=        # geheim, versleutelt de back-up; bewaar een kopie buiten GitHub, anders is de back-up onbruikbaar
# AANLEVERING_SLEUTEL=      # geheim, ontsleutelt aangeleverde bestanden van partners (data_pipeline.yml)
# STEALTH_PROXIES=          # geheim, optioneel, proxy's voor de stealth-lezer
# De pipeline en de stealth-lezer melden zich aan met een GitHub-OIDC-token: daar is geen secret voor nodig.

# ── Hulpmiddelen (tools/, lokaal) ───────────────────────────────────────────────────────────────────────────────────
# PIPELINE_KEY=             # geheim, zelfde waarde als internal_secrets.pipeline_key (tools/data-collectors)
# PIPELINE_URL=https://qkrmthrhwmmmwswmfgwc.supabase.co/functions/v1/pipeline
# PUSH_TEST_CERT= / PUSH_TEST_KEY=   # alleen lokaal voor notify_test.ts (testcertificaat, geen geheim van de site)
